; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="XuanDesk"
config/description="Switchable 3D desktop backgrounds (aquarium, ...) behind a floating clock and system-monitor HUD."
run/main_scene="res://shell/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/show_image=false
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/resizable=false
window/size/borderless=true
window/energy_saving/keep_screen_on=false
window/subwindows/embed_subwindows=false
window/per_pixel_transparency/allowed=true

[rendering]

anti_aliasing/quality/msaa_3d=2
; The RGB here is what Windows adds on top of the desktop across the whole of every
; per-pixel transparent window: a transparent viewport keeps the clear colour in its RGB
; with alpha 0, and DWM reads those pixels as premultiplied, so the colour shows up as a
; wash over everything the window covers. Measured 2026-11-03 on the live HUD as +3/+9/+14
; - exactly this colour - inside the window's rectangle and nothing just outside it. Black
; makes the wash invisible, which is what lets the HUD be a circle instead of a rectangle.
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
anti_aliasing/quality/screen_space_aa=1
